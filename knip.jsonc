{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true,
  },
  "ignoreIssues": {
    "**/*.gen.ts": ["exports", "types", "enumMembers"],
    "apps/web/src/components/assistant-ui/**": [
      "exports",
      "types",
      "enumMembers",
      "nsExports",
      "nsTypes",
    ],
  },
  "tags": ["-lintignore"],
  "treatConfigHintsAsErrors": true,
  "ignore": [".agents/**"],
  // Loaded through `ultracite/oxlint/shadcn`
  "ignoreDependencies": ["@shadcn/lint"],
  "workspaces": {
    "apps/agents": {
      "entry": ["src/mastra/index.ts"],
      "ignoreDependencies": ["vite"],
    },
    "apps/web": {
      "entry": ["src/lib/api.ts"],
    },
    "apps/desktop": {
      "entry": ["src/main/index.ts", "src/preload/index.ts"],
      "vite-plus": {
        "config": [
          "vite.config.ts",
          "vite.main.config.ts",
          "vite.preload.config.ts",
        ],
      },
    },
    "apps/server": {
      "entry": ["src/node.ts", "src/dev.ts"],
    },
  },
}
